# Optional, but recommended for higher NVD API rate limits.
# Request a key here: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Required for Checkpoint A10 onward: Gemini API key for answer generation via gemini-3.6-flash
# Free tier, no billing/credit card required. Request a key here: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OPENAI_API_KEY and OPENAI_MODEL are no longer used (switched to Gemini for free tier)
# OPENAI_API_KEY=
# OPENAI_MODEL=

